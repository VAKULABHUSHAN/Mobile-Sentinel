# ==============================================================================
# MOBILE SENTINEL - AI INTELLIGENCE LAYER CONFIGURATION (.env)
# ==============================================================================
# Copy this file to '.env' in your project root to configure the AI layer.
# DO NOT commit files containing real API keys or sensitive credentials.

# Enable or disable AI-assisted analysis (default: false)
SENTINEL_AI_ENABLED=false

# Active AI provider: gemini | openai | ollama | mock (default: gemini)
SENTINEL_AI_PROVIDER=gemini

# Specific LLM model to use (leave blank for recommended provider default)
# - Gemini default: gemini-1.5-flash
# - OpenAI default: gpt-4o-mini
# - Ollama default: llama3.2
# - Mock default:   mock-sentinel-ai
SENTINEL_AI_MODEL=

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Local Ollama Configuration (no API key required)
OLLAMA_BASE_URL=http://localhost:11434

# Request and Execution Safeguards
SENTINEL_AI_TIMEOUT=30
SENTINEL_AI_MAX_RETRIES=2
SENTINEL_AI_TEMPERATURE=0.2
SENTINEL_AI_CACHE_ENABLED=true
SENTINEL_AI_REDACTION_ENABLED=true
